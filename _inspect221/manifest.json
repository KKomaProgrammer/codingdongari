{
  "manifest_version": 3,
  "name": "이준우가 만든 종합 채팅 확장프로램",
  "version": "2.2.1",
  "description": "모든 사이트에서 사용할 수 있는 다중 방 실시간 채팅",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads"
  ],
  "host_permissions": [
    "https://supabase-settings-fetch.pages.dev/*",
    "*://*.supabase.co/*",
    "https://img.bloupla.net/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "이준우가 만든 종합 채팅 확장프로램",
    "default_icon": {
      "16": "assets/chat-ext-16.png",
      "32": "assets/chat-ext-32.png",
      "48": "assets/chat-ext-48.png",
      "128": "assets/chat-ext-128.png"
    }
  },
  "icons": {
    "16": "assets/chat-ext-16.png",
    "32": "assets/chat-ext-32.png",
    "48": "assets/chat-ext-48.png",
    "128": "assets/chat-ext-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/chat.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/chat-ext-48.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
